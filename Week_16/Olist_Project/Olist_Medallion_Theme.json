{
  "name": "Olist Medallion",
  "dataColors": [
    "#2E75B6", "#C55A11", "#548235", "#7030A0",
    "#1F3864", "#ED7D31", "#9DC3E6", "#A9D18E",
    "#BF9000", "#595959"
  ],
  "background": "#FFFFFF",
  "foreground": "#1F3864",
  "tableAccent": "#2E75B6",
  "maximum": "#1F3864",
  "center": "#9DC3E6",
  "minimum": "#DEEAF6",
  "null": "#F2F2F2",
  "textClasses": {
    "title": {
      "color": "#1F3864",
      "fontSize": 16,
      "fontFace": "Segoe UI Semibold"
    },
    "header": {
      "color": "#2E75B6",
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold"
    },
    "label": {
      "color": "#595959",
      "fontSize": 10,
      "fontFace": "Segoe UI"
    },
    "callout": {
      "color": "#C55A11",
      "fontSize": 40,
      "fontFace": "Segoe UI"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#DEEAF6" } }, "radius": 6 }],
        "visualHeaderTooltip": [{ "text": "" }],
        "title": [{
          "show": true,
          "fontColor": { "solid": { "color": "#1F3864" } },
          "fontSize": 14,
          "fontFamily": "Segoe UI Semibold",
          "alignment": "left"
        }]
      }
    },
    "card": {
      "*": {
        "labels": [{ "color": { "solid": { "color": "#C55A11" } }, "fontSize": 32, "fontFamily": "Segoe UI" }],
        "categoryLabels": [{ "color": { "solid": { "color": "#595959" } }, "fontSize": 11 }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F7FAFD" } }, "transparency": 0 }]
      }
    }
  }
}
